# Variables públicas del cliente Expo (se embeben en el bundle — NO poner secretos).
# La seguridad de datos se delega a RLS de Supabase; la anon key es pública por diseño.

EXPO_PUBLIC_SUPABASE_URL=your_supabase_url
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# URL del backend FastAPI (OCR de recibos, predicciones e insights).
EXPO_PUBLIC_API_URL=https://tu-backend.example.com

# DSN de Sentry (opcional). Sin valor, Sentry queda desactivado.
EXPO_PUBLIC_SENTRY_DSN=
