# Supabase (lado servidor)
SUPABASE_URL=your_supabase_url
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# JWT Secret de Supabase (Project Settings → API → JWT Secret).
# Necesario para verificar la identidad del usuario en los endpoints protegidos.
SUPABASE_JWT_SECRET=your_supabase_jwt_secret

# Google Gemini — clave usada SOLO server-side para el OCR de recibos.
# NO exponer como EXPO_PUBLIC_ en el cliente.
GEMINI_API_KEY=your_google_ai_api_key

# Anthropic Claude — usado server-side para interpretar el dictado por voz
# (/parse). Se usa Claude en vez de Gemini porque el free tier de Gemini se agota
# (~20 req/día). Consíguela en console.anthropic.com. Opcional: ANTHROPIC_MODEL.
ANTHROPIC_API_KEY=your_anthropic_api_key

# Syncfy (Open Data) — clave server-side para conexión bancaria.
SYNCFY_API_KEY=your_syncfy_api_key
